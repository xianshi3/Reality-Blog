# Supabase Project Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # 服务端存储管理（删除图片），不配置则 /api/storage 删除不可用

# 管理员邮箱（可选但强烈建议配置）
# 配置后后台页面与写接口仅允许该邮箱的登录用户，防止其他注册用户越权
ADMIN_EMAIL=admin@example.com

# AI Chat API (ZhipuAI / GLM)
ZHIPU_API_KEY=your-zhipu-api-key

# GitHub 项目展示（可选，不配置则使用未认证 API，每小时限 60 次）
GITHUB_TOKEN=your-github-personal-token

# Site URL (用于 sitemap / robots / SEO 元数据)
NEXT_PUBLIC_SITE_URL=https://your-domain.com
